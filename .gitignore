# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# 가상환경
.venv/
.venv-*/

# 데이터: KUDGE는 `make data`로 내려받는다 (응답 본문이 31개 모델의 출력이라 넣지 않음)
data/
*.csv

# 학습·서빙 산출물 (가중치, 로그). 예측(점수·점수 분포만, 응답 본문 없음)과
# 학습 요약(train_summary.json)은 결과 수치의 근거라 넣는다
outputs/*
!outputs/predictions/
!outputs/lora/
outputs/lora/*/*/*
!outputs/lora/*/*/train_summary.json
runs/
wandb/
*.safetensors
*.bin
*.pt
*.npz

# 비밀
.env
*.key

# OS·IDE
.DS_Store
.idea/
.vscode/
